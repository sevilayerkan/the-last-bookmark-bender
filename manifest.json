{
  "manifest_version": 3,
  "name": "The Last Bookmark Bender",
  "version": "1.0.0",
  "description": "Temporary bookmarks with retention rules, warnings, and a final 24-hour grace period.",
  "permissions": ["activeTab", "tabs", "bookmarks", "storage", "alarms", "notifications"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "The Last Bookmark Bender",
    "default_popup": "popup/popup.html"
  },
  "options_page": "settings/settings.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
